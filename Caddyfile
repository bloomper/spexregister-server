{
    local_certs
    http_port 0
    https_port 8443
}

auth.fgv.local.nu:8443 {
    tls internal
    reverse_proxy auth:8081
}

api.register.fgv.local.nu:8443 {
    tls internal
    reverse_proxy api:8080 {
        header_up X-Forwarded-Port {http.request.port}
    }
}

mail.fgv.local.nu:8443 {
    tls internal
    reverse_proxy mail:8025
}