extend type Query {
    events(sourceType: SourceType!, sinceInDays: Int = 90): [Event]
}

type Event {
    id: ID!
    eventType: EventType!
    sourceType: SourceType!
    sourceId: Long!
    createdBy: String!
    createdAt: Instant!
}

enum EventType {
    CREATE
    UPDATE
    REMOVE
}

enum SourceType {
    NEWS
    SPEX
    SPEX_CATEGORY
    SPEXARE
    TAG
    TASK
    TASK_CATEGORY
    USER
}
