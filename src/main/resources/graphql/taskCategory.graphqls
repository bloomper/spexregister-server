# Spexipedia keeps base data; this is the copy the sync writes (spexregister-spec, docs/base-data-and-memberships.md, 3).
extend type Query {
    "Every role."
    taskCategoryPaged(first: Int, after: String, last: Int, before: String, filter: String! = "", sort: [String]! = ["name"], direction: SortDirection = ASC): TaskCategoryConnection
    "Every role."
    taskCategory(id: ID!): TaskCategory
}


"A group of tasks."
type TaskCategory {
    id: ID!
    name: String!
    "Whether the tasks are performed on stage as an actor."
    actorPresent: Boolean!
    "Whether Spexipedia shows its tasks as the board of a spex."
    board: Boolean!
    "Retired in Spexipedia."
    retired: Boolean!
    createdBy: String!
    createdAt: Instant!
    lastModifiedBy: String
    lastModifiedAt: Instant
}

type TaskCategoryConnection {
    edges: [TaskCategoryEdge]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type TaskCategoryEdge {
    cursor: String!
    node: TaskCategory!
}


