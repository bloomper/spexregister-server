extend type Query {
    "Every role."
    taskCategoryPaged(first: Int, after: String, last: Int, before: String, filter: String! = "", sort: [String]! = ["name"], direction: SortDirection = ASC): TaskCategoryConnection
    "Every role."
    taskCategory(id: ID!): TaskCategory
    "ADMIN or EDITOR."
    taskCategoryExport(ids: [ID], filter: String, type: ImpexType!): JobReference
}

extend type Mutation {
    "ADMIN."
    taskCategoryCreate(input: TaskCategoryCreate!): TaskCategory
    "ADMIN."
    taskCategoryUpdate(input: TaskCategoryUpdate!): TaskCategory
    "ADMIN."
    taskCategoryDelete(id: ID!): Void
}

"A group of tasks."
type TaskCategory {
    id: ID!
    name: String!
    "Whether the tasks are performed on stage as an actor."
    actorPresent: Boolean!
    createdBy: String!
    createdAt: Instant!
    lastModifiedBy: String
    lastModifiedAt: Instant
}

type TaskCategoryConnection {
    edges: [TaskCategoryEdge]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type TaskCategoryEdge {
    cursor: String!
    node: TaskCategory!
}

input TaskCategoryCreate {
    name: String!
    actorPresent: Boolean!
}

input TaskCategoryUpdate {
    id: ID!
    name: String!
    actorPresent: Boolean!
}
