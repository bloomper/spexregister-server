# Spexipedia keeps base data; this is the copy the sync writes (spexregister-spec, docs/base-data-and-memberships.md, 3).
extend type Query {
    "Every role."
    taskPaged(first: Int, after: String, last: Int, before: String, filter: String! = "", sort: [String]! = ["name"], direction: SortDirection = ASC): TaskConnection
    "Every role."
    task(id: ID!): Task
}


"A role a spexare can have in a spex, such as director or musician."
type Task {
    id: ID!
    name: String!
    "Retired in Spexipedia: kept on activities, not offered for new ones."
    retired: Boolean!
    "Whether Spexipedia shows it as a task of the board (the direktion) of a spex."
    board: Boolean!
    category: TaskCategory
    createdBy: String!
    createdAt: Instant!
    lastModifiedBy: String
    lastModifiedAt: Instant
}

type TaskConnection {
    edges: [TaskEdge]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type TaskEdge {
    cursor: String!
    node: Task!
}


