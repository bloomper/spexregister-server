extend type Query {
    """
    ADMIN, EDITOR or USER. Spexare, spex, tasks and tags matching q, by label. A blank q gives the caller's own spexare,
    or a random one.
    """
    graphSearch(q: String!, first: Int! = 10): [GraphNode!]!
    "ADMIN, EDITOR or USER. The node with at most first neighbours of each edge type."
    graphNeighbourhood(type: GraphNodeType!, id: ID!, first: Int! = 25): GraphNeighbourhood
    "ADMIN, EDITOR or USER. All neighbours of the node along one edge type."
    graphNeighboursPaged(type: GraphNodeType!, id: ID!, edge: GraphEdgeType!, first: Int, after: String, last: Int, before: String): GraphNodeConnection
}

"What a node is."
enum GraphNodeType {
    SPEXARE
    SPEX
    SPEX_CATEGORY
    TASK
    TASK_CATEGORY
    TAG
}

"""
How two nodes are related: a spexare took part in a spex (PARTICIPATION) or held a task in it (FUNCTION), something is
in a category (CATEGORY), a spexare has a tag (TAG) or a partner (PARTNER), or a spex is a revival of another
(REVIVAL_OF).
"""
enum GraphEdgeType {
    PARTICIPATION
    FUNCTION
    CATEGORY
    TAG
    PARTNER
    REVIVAL_OF
}

"A spexare, spex, task, tag or category in the graph."
type GraphNode {
    "The node's id in the graph, such as SPEXARE:42."
    id: ID!
    type: GraphNodeType!
    label: String!
    sublabel: String
    imageUrl: String
    revival: Boolean!
    "The id of the entity."
    entityId: ID!
}

"A relation between two nodes, by their graph ids."
type GraphEdge {
    id: ID!
    source: ID!
    target: ID!
    type: GraphEdgeType!
    "Such as the year of a participation or the roles played in a task."
    label: String
}

"The neighbours of a node along one edge type."
type GraphGroup {
    type: GraphEdgeType!
    totalCount: Int!
    nodes: [GraphNode!]!
    edges: [GraphEdge!]!
}

"A node and its neighbours."
type GraphNeighbourhood {
    origin: GraphNode!
    groups: [GraphGroup!]!
}

type GraphNodeConnection {
    edges: [GraphNodeEdge]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type GraphNodeEdge {
    cursor: String!
    node: GraphNode!
}
