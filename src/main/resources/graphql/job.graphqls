extend type Query {
    jobStatus(id: ID!): JobStatus
}

extend type Subscription {
    jobProgress(id: ID!): JobStatus
}

type JobReference {
    id: ID!
}

type JobStatus {
    id: ID!
    status: String!
    exitStatus: String
    importResult: ImportResult
}

type ImportResult {
    success: Boolean!
    errors: [String]
    messages: [String]
    data: JSON
}
