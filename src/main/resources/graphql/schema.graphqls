schema {
    query: Query
    mutation: Mutation
    subscription: Subscription
}

type Query {
    noOp: Void
}

type Mutation {
    noOp: Void
}

type Subscription {
    noOp: Void
}

type Facet {
    id: String!
    label: String!
    groups: [FacetGroup]!
}

type FacetGroup {
    id: String!
    label: String!
    values: [FacetValue]!
}

type FacetValue {
    id: String!
    label: String!
    count: Int!
}

input AggregationFilterInput {
    name: String!
    value: String!
}

type PageInfo {
    hasPreviousPage: Boolean!
    hasNextPage: Boolean!
    startCursor: String
    endCursor: String
}

enum SortDirection {
    ASC
    DESC
}

enum ImpexType {
    EXCEL
    EXCEL_XLS
    PDF
}

enum ReportType {
    PDF_ADDRESS_LABELS
    PDF_SCRATCH_LIST
    PDF_PLATOON_LIST
}

scalar Date @specifiedBy(url:"https://tools.ietf.org/html/rfc3339")
scalar DateTime @specifiedBy(url:"https://tools.ietf.org/html/rfc3339")
scalar Instant @specifiedBy(url:"https://tools.ietf.org/html/rfc3339")
scalar Locale @specifiedBy(url:"https://tools.ietf.org/html/bcp47")
scalar CountryCode @specifiedBy(url:"https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2")
scalar Email
scalar Year
scalar SocialSecurityNumber
scalar Void
scalar Long
scalar JSON
