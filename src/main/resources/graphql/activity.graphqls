extend type Mutation {
    "Every role, with WRITE on the spexare. Adds an empty activity, to be given a spex and tasks."
    activityCreate(spexareId: ID!): Activity
    "ADMIN, EDITOR or USER with WRITE on the spexare. Removes the activity with its spex and task activities."
    activityDelete(spexareId: ID!, id: ID!): Void
}

"A spexare's participation in one spex: the spex activity names the spex and the task activities the tasks."
type Activity {
    id: ID!
    spexActivity: SpexActivity
    taskActivitiesPaged(first: Int, after: String, last: Int, before: String, sort: [String]! = ["id"], direction: SortDirection = ASC): TaskActivityConnection
    taskActivities: [TaskActivity]
    createdBy: String!
    createdAt: Instant!
    lastModifiedBy: String
    lastModifiedAt: Instant
}

type ActivityConnection {
    edges: [ActivityEdge]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type ActivityEdge {
    cursor: String!
    node: Activity!
}