# Spexipedia keeps base data; this is the copy the sync writes (spexregister-spec, docs/base-data-and-memberships.md, 3).
extend type Query {
    "Every role. Only original spex by default; filter on parent!NULL for the revivals."
    spexPaged(first: Int, after: String, last: Int, before: String, filter: String! = "parent:NULL", sort: [String]! = ["year"], direction: SortDirection = ASC): SpexConnection
    "Every role."
    spex(id: ID!): Spex
}


"""
A spex in a year: an original production, or a revival of one when parent is set. Title, poster and category are shared
by an original and its revivals.
"""
type Spex {
    id: ID!
    year: Year!
    title: String!
    "Whether this is a revival."
    revival: Boolean
    "The original, for a revival. Not for the REVIVAL role."
    parent: SpexParent
    "Spexipedia's public address of the poster, when there is one: its own, else its original's for a revival."
    posterUrl: String
    "Retired in Spexipedia: kept on activities, not offered for new ones."
    retired: Boolean!
    "Not for the REVIVAL role."
    category: SpexCategory
    "By year."
    revivals: [SpexRevival]
    createdBy: String!
    createdAt: Instant!
    lastModifiedBy: String
    lastModifiedAt: Instant
}

"The original of a revival."
type SpexParent {
    id: ID!
    year: Year!
    createdBy: String!
    createdAt: Instant!
    lastModifiedBy: String
    lastModifiedAt: Instant
}

"A revival of a spex."
type SpexRevival {
    id: ID!
    year: Year!
    createdBy: String!
    createdAt: Instant!
    lastModifiedBy: String
    lastModifiedAt: Instant
}

type SpexConnection {
    edges: [SpexEdge]!
    pageInfo: PageInfo!
    totalCount: Int!
}

type SpexEdge {
    cursor: String!
    node: Spex!
}

